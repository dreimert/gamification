{
    "root": true,
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
    },
    "extends": [
        "eslint:recommended",
        "plugin:prettier/recommended"
    ],
    "env": {
        "browser": true,
        "es2021": true,
        "node": true
    },
    "rules": {
        "no-console": "error",
        "prettier/prettier": [
            "error",
            {
                "printWidth": 120,
                "parser": "flow"
            }
        ]
    }
}
